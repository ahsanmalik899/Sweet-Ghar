{
  "expo": {
    "scheme": "sweetghar",
    "name": "SweetGhar",
    "slug": "sweet-ghar",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon 1024x1024.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.revnosoft.sweetghar",
      "associatedDomains": [
        "applinks:sweetghar.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app-icon 1024x1024.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDSMUvHsKNRuzj67lJ3HZrzTtFzRlVgPkU"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.sweetghar.com",
              "pathPrefix": "/CreateNewpass"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.sweetghar.com",
              "pathPrefix": "/Account"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.sweetghar.com",
              "pathPrefix": "/NewsFeedSingelView"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.sweetghar.com",
              "pathPrefix": "/AddSingleView"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.sweetghar.com",
              "pathPrefix": "/postRedirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.revnosoft.sweetghar"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "react-native-share",
        {
          "ios": [
            "whatsapp",
            "fb",
            "twitter"
          ],
          "android": [
            "com.whatsapp",
            "com.facebook.katana",
            "com.linkedin.android",
            "com.twitter.android"
          ]
        }
      ],
    [
  "expo-build-properties",
  {
    "android": {
      "enableMinifyInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    }
  }
]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "GOOGLE_MAPS_API_KEY": "AIzaSyDSMUvHsKNRuzj67lJ3HZrzTtFzRlVgPkU",
      "eas": {
        "projectId": "ed7335d6-7a0e-4200-90db-3f7a4f6ab4c0"
      }
    }
  }
}
